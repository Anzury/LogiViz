---
import { CHAPTERS, UPCOMING, chapterHref, chapterTone } from '../chapters';
import Base from './Base.astro';

interface Props {
  frontmatter: { chapter: number };
}
const { chapter } = Astro.props.frontmatter;
const info = CHAPTERS.find((c) => c.number === chapter)!;
const next = CHAPTERS.find((c) => c.number === chapter + 1);
const base = import.meta.env.BASE_URL;
---

<Base title={`${info.title} · Chapitre ${chapter}`} description={info.summary} chapter={chapter}>
  <header class="hero">
    <div class="card">
      <p class="eyebrow">Chapitre {chapter} sur {CHAPTERS.length}</p>
      <h1>{info.title}</h1>
      <p class="lede">{info.summary}</p>
      <p class="hint">Fais défiler pour avancer. Fais glisser la maquette pour la tourner.</p>
    </div>
    <button type="button" class="step-next" data-step-next aria-label="Première étape">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
    </button>
  </header>

  <slot />

  {
    next ? (
      <a class="card onward" href={chapterHref(base, next.number)} style={`--tone: ${chapterTone(next.number)}`}>
        <span class="tile">{next.number}</span>
        <div class="card-text">
          <span class="eyebrow">La suite</span>
          <h3>{next.title}</h3>
          <p>{next.summary}</p>
          <span class="card-go">
            Chapitre suivant <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </span>
        </div>
      </a>
    ) : (
      <div class="card onward">
        <p class="eyebrow">{UPCOMING.label}</p>
        <h3>{UPCOMING.title}</h3>
        <p>{UPCOMING.summary}</p>
      </div>
    )
  }
</Base>

<script>
  import { boot } from '../chapter/page';
  boot(Number(document.body.dataset.chapter));
</script>
