---
import { CHAPTERS, UPCOMING, chapterHref, chapterTone } from '../chapters';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base
  title="La tournée du livreur"
  description="Comprendre les algorithmes de tournées de livraison, pas à pas, sur une maquette en 3D à manipuler."
>
  <div class="home">
    <header class="card hero">
      <p class="eyebrow">LogiViz</p>
      <h1>La tournée du livreur</h1>
      <p class="lede">
        Dans quel ordre un camion doit-il faire ses livraisons ? {CHAPTERS.length} chapitres pour comprendre, pas à pas, comment les
        algorithmes organisent des tournées, sur une maquette que tu peux manipuler.
      </p>
      <p class="hint">Fais glisser la maquette pour la tourner.</p>
    </header>

    <ol class="contents">
      {
        CHAPTERS.map((chapter) => (
          <li>
            <a class="card" href={chapterHref(base, chapter.number)} style={`--tone: ${chapterTone(chapter.number)}`}>
              <span class="tile">{chapter.number}</span>
              <div class="card-text">
                <h3>{chapter.title}</h3>
                <p>{chapter.summary}</p>
                <span class="card-go">
                  Lire le chapitre <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
      <li>
        <div class="card is-upcoming">
          <p class="eyebrow">{UPCOMING.label}</p>
          <h3>{UPCOMING.title}</h3>
          <p>{UPCOMING.summary}</p>
        </div>
      </li>
    </ol>
  </div>
</Base>

<script>
  import { bootHome } from '../chapter/page';
  bootHome();
</script>
